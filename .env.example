# ==============================================================================
# HAKUYOMI VOICE API - Plantilla de Variables de Entorno (.env.example)
# Copiar a .env y definir valores reales. Nunca commitear .env al repositorio.
# ==============================================================================

# --- Aplicación FastAPI ---
APP_NAME=hakuyomi-voice-api
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Seguridad y Autenticación Estandarizada ---
API_AUTH_TOKEN=<REPLACE_WITH_SECURE_API_TOKEN>
APP_UID=10001
APP_GID=10001

# --- Base de Datos PostgreSQL ---
POSTGRES_USER=hakuyomi_user
POSTGRES_PASSWORD=<REPLACE_WITH_POSTGRES_PASSWORD>
POSTGRES_DB=hakuyomi_voice_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hakuyomi_user:<REPLACE_WITH_POSTGRES_PASSWORD>@db:5432/hakuyomi_voice_db

# --- Modelos Ligeros Exclusivos (Presupuesto < 10 GB) ---
STT_MODEL_NAME=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
MODEL_CACHE_DIR=/app/models

TTS_ENGINE=piper-tts
PIPER_VOICE_MODEL=es_MX-cori-high
PIPER_SAMPLE_RATE=22050

# --- Almacenamiento Temporal de Audio Adjunto y Streaming (Límite 10 MB) ---
TEMP_AUDIO_DIR=/tmp/hakuyomi_audio
MAX_UPLOAD_SIZE_MB=10
TEMP_FILE_TTL_SECONDS=300
WS_MAX_BUFFER_BYTES=10485760
WS_CHUNK_DURATION_MS=2000
